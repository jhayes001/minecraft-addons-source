{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "heist:guard",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "patrol": "textures/entity/ender_guard_0",
        "huh": "textures/entity/ender_guard_1",
        "chase": "textures/entity/ender_guard_2"
      },
      "geometry": {
        "default": "geometry.ender_guard"
      },
      "animations": {
        "walk": "animation.ender_guard.walk",
        "look": "animation.ender_guard.look",
        "run": "animation.ender_guard.run",
        "idle": "animation.ender_guard.idle"
      },
      "scripts": {
        "animate": [
          {
            "walk": "query.mark_variant == 0"
          },
          {
            "look": "query.mark_variant == 1"
          },
          {
            "run": "query.mark_variant == 2"
          },
          {
            "idle": "query.mark_variant == 3"
          }
        ]
      },
      "render_controllers": [
        "controller.render.ender_guard"
      ]
    }
  }
}
