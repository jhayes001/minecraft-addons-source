{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.ender_guard": {
      "arrays": {
        "textures": {
          "Array.moods": [
            "Texture.patrol",
            "Texture.huh",
            "Texture.chase",
            "Texture.patrol"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.moods[query.mark_variant]"
      ]
    },
    "controller.render.heist_crown": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "part_visibility": [
        {
          "cushion": "query.mark_variant == 0"
        }
      ]
    }
  }
}
