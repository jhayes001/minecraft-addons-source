{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.ender_guard": {
      "arrays": {
        "textures": {
          "Array.moods": [
            "Texture.patrol",
            "Texture.huh",
            "Texture.chase",
            "Texture.patrol"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.moods[query.mark_variant]"
      ]
    },
    "controller.render.heist_crown": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "part_visibility": [
        {
          "cushion": "query.mark_variant == 0"
        },
        {
          "crown": "query.variant == 0"
        },
        {
          "boots": "query.variant == 1"
        },
        {
          "pants": "query.variant == 2"
        },
        {
          "chest": "query.variant == 3"
        },
        {
          "sword": "query.variant == 4"
        },
        {
          "apple": "query.variant == 5"
        },
        {
          "chest_box": "query.variant == 6"
        },
        {
          "cape": "query.variant == 7"
        }
      ]
    }
  }
}
