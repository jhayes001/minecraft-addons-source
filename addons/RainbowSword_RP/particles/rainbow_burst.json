{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "rainbow:burst",
      "basic_render_parameters": { "material": "particles_blend", "texture": "textures/particle/rainbow_spark" }
    },
    "components": {
      "minecraft:emitter_rate_instant": { "num_particles": 40 },
      "minecraft:emitter_lifetime_once": { "active_time": 0 },
      "minecraft:emitter_shape_sphere": { "radius": 0.3, "direction": "outwards" },
      "minecraft:particle_lifetime_expression": { "max_lifetime": "0.8 + variable.particle_random_2 * 0.6" },
      "minecraft:particle_initial_speed": "3 + variable.particle_random_3 * 3",
      "minecraft:particle_motion_dynamic": { "linear_acceleration": [0, -2, 0], "linear_drag_coefficient": 2.5 },
      "minecraft:particle_appearance_billboard": {
        "size": ["0.2 * (1 - variable.particle_age / variable.particle_lifetime) + 0.04", "0.2 * (1 - variable.particle_age / variable.particle_lifetime) + 0.04"],
        "facing_camera_mode": "rotate_xyz",
        "uv": { "texture_width": 8, "texture_height": 8, "uv": [0, 0], "uv_size": [8, 8] }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "variable.particle_random_1",
          "gradient": {
            "0.0": "#FFFF3B3B", "0.17": "#FFFF9A2E", "0.34": "#FFFFF04A",
            "0.5": "#FF4CFF5E", "0.67": "#FF3FA9FF", "0.84": "#FF6A55FF", "1.0": "#FFD45BFF"
          }
        }
      }
    }
  }
}
