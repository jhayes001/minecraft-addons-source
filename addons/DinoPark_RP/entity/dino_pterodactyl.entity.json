{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "dino:pterodactyl",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/dino_pterodactyl"
      },
      "geometry": {
        "default": "geometry.dino_pterodactyl"
      },
      "animations": {
        "look": "animation.dino.pterodactyl.look",
        "fly": "animation.dino.pterodactyl.fly",
        "perch": "animation.dino.pterodactyl.perch",
        "waddle": "animation.dino.pterodactyl.waddle"
      },
      "scripts": {
        "animate": [
          "look",
          {
            "fly": "query.property('dino:flying')"
          },
          {
            "perch": "!query.property('dino:flying')"
          },
          {
            "waddle": "!query.property('dino:flying') && query.property('dino:walking')"
          }
        ]
      },
      "render_controllers": [
        "controller.render.default"
      ]
    }
  }
}
