{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alphadog:dog",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/alpha_dog"
      },
      "geometry": {
        "default": "geometry.alpha_dog"
      },
      "animations": {
        "walk": "animation.alpha_dog.walk",
        "look_at_target": "animation.alpha_dog.look_at_target",
        "wag": "animation.alpha_dog.wag",
        "pant": "animation.alpha_dog.pant",
        "puppy": "animation.alpha_dog.puppy",
        "gait": "animation.alpha_dog.gait",
        "gallop": "animation.alpha_dog.gallop",
        "gallop_sounds": "controller.animation.alpha_dog.gallop",
        "chew": "animation.alpha_dog.chew"
      },
      "scripts": {
        "animate": [
          "walk",
          "gait",
          "look_at_target",
          "wag",
          "pant",
          {
            "puppy": "query.variant == 0"
          },
          "gallop_sounds",
          {
            "chew": "query.mark_variant == 1"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alpha_dog"
      ],
      "sound_effects": {
        "paw": "mob.ravager.step",
        "pant": "mob.wolf.panting"
      },
      "particle_effects": {
        "dirt_kick": "alphadog:dirt_kick",
        "wood_chip": "alphadog:wood_chip"
      }
    }
  }
}
