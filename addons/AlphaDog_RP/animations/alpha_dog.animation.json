{
  "format_version": "1.8.0",
  "animations": {
    "animation.alpha_dog.walk": {
      "loop": true,
      "bones": {
        "leg_fl": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17) * 50 * query.modified_move_speed",
            0,
            0
          ]
        },
        "leg_br": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17) * 50 * query.modified_move_speed",
            0,
            0
          ]
        },
        "leg_fr": {
          "rotation": [
            "-math.cos(query.modified_distance_moved * 38.17) * 50 * query.modified_move_speed",
            0,
            0
          ]
        },
        "leg_bl": {
          "rotation": [
            "-math.cos(query.modified_distance_moved * 38.17) * 50 * query.modified_move_speed",
            0,
            0
          ]
        }
      }
    },
    "animation.alpha_dog.look_at_target": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": [
            "query.target_x_rotation",
            "query.target_y_rotation",
            0
          ]
        }
      }
    },
    "animation.alpha_dog.wag": {
      "loop": true,
      "bones": {
        "tail": {
          "rotation": [
            0,
            "math.sin(query.life_time * (700 + query.modified_move_speed * 500)) * 32",
            0
          ]
        }
      }
    },
    "animation.alpha_dog.pant": {
      "loop": true,
      "bones": {
        "tongue": {
          "position": [
            0,
            "math.sin(query.life_time * 650) * 0.25 - 0.1",
            0
          ]
        },
        "body": {
          "scale": [
            1,
            "1 + math.sin(query.life_time * 650) * 0.012",
            1
          ]
        }
      }
    },
    "animation.alpha_dog.puppy": {
      "loop": true,
      "bones": {
        "head": {
          "scale": 1.35
        },
        "ear_l": {
          "scale": [
            1.1,
            1.3,
            1.1
          ]
        },
        "ear_r": {
          "scale": [
            1.1,
            1.3,
            1.1
          ]
        }
      }
    },
    "animation.alpha_dog_egg.wobble": {
      "loop": true,
      "bones": {
        "egg": {
          "rotation": [
            0,
            0,
            "math.sin(query.life_time * 520) * (4 + math.min(query.life_time, 10) * 1.4)"
          ]
        }
      }
    },
    "animation.alpha_dog.gait": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": [
            "math.sin(query.modified_distance_moved * 38.17 * 2) * (4 + query.has_rider * 5) * query.modified_move_speed",
            0,
            0
          ]
        },
        "body": {
          "position": [
            0,
            "math.abs(math.cos(query.modified_distance_moved * 38.17)) * 0.6 * query.modified_move_speed",
            0
          ]
        },
        "ear_r": {
          "rotation": [
            "math.sin(query.modified_distance_moved * 38.17 * 2 - 40) * 12 * query.modified_move_speed",
            0,
            "math.sin(query.modified_distance_moved * 38.17 * 2) * 24 * query.modified_move_speed"
          ]
        },
        "ear_l": {
          "rotation": [
            0,
            0,
            "math.sin(query.modified_distance_moved * 38.17 * 2 - 25) * 5 * query.modified_move_speed"
          ]
        }
      }
    }
  }
}
