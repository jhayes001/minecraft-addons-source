{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "starshield:firework_burst",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/dot"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 140
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.2,
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "math.random(8, 10)",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.4, 2.2)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -2.2,
          0
        ],
        "linear_drag_coefficient": 3.2
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.16 * (1 - v.particle_age / v.particle_lifetime * 0.7)",
          "0.16 * (1 - v.particle_age / v.particle_lifetime * 0.7)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 8,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.color.r",
          "v.color.g",
          "v.color.b",
          "(v.particle_age / v.particle_lifetime > 0.6 && math.mod(math.floor(v.particle_age * 20 + v.particle_random_1 * 7), 2) == 0) ? 0.2 : 1.0"
        ]
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}