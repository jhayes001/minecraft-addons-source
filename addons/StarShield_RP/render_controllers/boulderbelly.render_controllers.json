{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.boulderbelly": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "part_visibility": [
        {
          "*": true
        },
        {
          "crystal_0": "query.property('starshield:crystals') >= 1"
        },
        {
          "crystal_1": "query.property('starshield:crystals') >= 2"
        },
        {
          "crystal_2": "query.property('starshield:crystals') >= 3"
        }
      ]
    }
  }
}
