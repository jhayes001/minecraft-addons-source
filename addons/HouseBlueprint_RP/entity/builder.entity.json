{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "house:builder",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "look_0": "textures/entity/house_builder_0",
        "look_1": "textures/entity/house_builder_1",
        "look_2": "textures/entity/house_builder_2",
        "look_3": "textures/entity/house_builder_3"
      },
      "geometry": {
        "default": "geometry.house_builder"
      },
      "animations": {
        "idle": "animation.house_builder.idle",
        "walk": "animation.house_builder.walk",
        "hammer": "animation.house_builder.hammer",
        "wave": "animation.house_builder.wave",
        "cheer": "animation.house_builder.cheer"
      },
      "scripts": {
        "animate": [
          "idle",
          {
            "walk": "query.mark_variant == 1"
          },
          {
            "hammer": "query.mark_variant == 2"
          },
          {
            "wave": "query.mark_variant == 3"
          },
          {
            "cheer": "query.mark_variant == 4"
          }
        ]
      },
      "render_controllers": [
        "controller.render.house_builder"
      ],
      "spawn_egg": {
        "base_color": "#f6ba1e",
        "overlay_color": "#fa7e1e"
      }
    }
  }
}
